#!/usr/bin/env bash

# sample_app/ is a copy of Scylla-K8s-Example/sample_app. Block a commit that touches
# sample_app/ while the copy is out of date; for any other commit only warn.
#
# Install once per clone:  git config core.hooksPath githooks
# Bypass once with:        git commit --no-verify

top=$(git rev-parse --show-toplevel)
sync="$top/sync_sample_app.bash"
[[ -x $sync ]] || exit 0

out=$("$sync" --check 2>&1)
rc=$?
[[ $rc == 0 ]] && exit 0
if [[ $rc == 2 ]]; then
    printf 'pre-commit: sample_app check skipped: %s\n' "$out" >&2
    exit 0
fi

if git diff --cached --name-only -- sample_app | grep -q .; then
    printf 'pre-commit: %s\n\nRun ./sync_sample_app.bash, stage sample_app/, and commit again.\n' "$out" >&2
    exit 1
fi
printf 'pre-commit: warning: %s\n(not blocking: this commit does not touch sample_app/)\n' "$out" >&2
exit 0
