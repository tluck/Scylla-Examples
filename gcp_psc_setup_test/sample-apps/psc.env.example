# Settings for the PSC sample apps, read by psc_env.bash. Copy to psc.env (the default) or psc-<name>.env
# (select it with PSC_ENV=...); *.env files are git-ignored. psc_generate_client.bash writes these for you.
# No password here: export SCYLLA_PASSWORD (or PASSWORD from ../../sc_api/cluster-<id>.env).

# psc: through a PSC endpoint with client routes (psc_generate_client.bash writes these)
SCYLLA_MODE=psc
SCYLLA_PSC_DNS=scylla-psc-nr00000-00000000.clusters.scylla.cloud
SCYLLA_PSC_CONN_ID=00000000-0000-0000-0000-000000000000
SCYLLA_PSC_PORT=9000
SCYLLA_DC=GCE_US_WEST_1

# direct: straight to the nodes, e.g. over VPC peering (direct_env.bash writes these). Replace the psc lines:
# SCYLLA_MODE=direct
# SCYLLA_CONTACT_POINTS=node-0.<dc>.<hash>.clusters.scylla.cloud,node-1...,node-2...
# SCYLLA_PORT=           # sample default: 9042 / 9142 with TLS (Java: 19042 / 19142)
# SCYLLA_USER=scylla

# TLS PSC connection only (relative paths are relative to this file)
# SCYLLA_CA_FILE=../ca-<cluster_id>.pem
# SCYLLA_TLS_NAME=<uuid>.scylla-cloud.invalid
