# Copy to config.env and edit. clusters.sh sources it automatically.
#
# Anything here can be overridden per run with a flag: -l name, -r region,
# -v vcpu, -t TiB, -F instance-family, -i cidr. Select which permutations to
# act on with -p aws|gcp and -o byoa|scylla.
#   cp config.env.example config.env
#
# config.env is gitignored (it may hold your token and account IDs).
# Every value here can also just be exported in your shell.

# --- Authentication (required) ---------------------------------------------
# Get a token: https://cloud.docs.scylladb.com/stable/api-docs/api-get-started.html
# clusters.sh also falls back to $SC_TOKEN if this is unset.
#export SCYLLADB_CLOUD_TOKEN="..."

# --- Naming ----------------------------------------------------------------
# Clusters are named <prefix>-<permutation>, e.g. tf-demo-aws-byoa
export CLUSTER_PREFIX="tf-demo"

# --- Regions ---------------------------------------------------------------
export AWS_REGION="us-east-1"
export GCP_REGION="us-central1"

# --- BYOA credential IDs (required for the *-byoa permutations) ------------
# Add your cloud account in the ScyllaDB Cloud portal first, then find its ID:
#
#   ACCOUNT=$(curl -s -H "Authorization: Bearer $SCYLLADB_CLOUD_TOKEN" \
#     https://api.cloud.scylladb.com/account/default | jq -r .data.accountId)
#   curl -s -H "Authorization: Bearer $SCYLLADB_CLOUD_TOKEN" \
#     https://api.cloud.scylladb.com/account/$ACCOUNT/cloud-account | jq
#
# Use the id of an entry whose "owner" is "Account" (yours), not "Scylla".
#export AWS_BYOA_ID="12345"
#export GCP_BYOA_ID="12346"

# --- GCP project (required for both gcp-* permutations) --------------------
#export GCP_PROJECT_ID="my-gcp-project"

# --- X Cloud autoscaling policy --------------------------------------------
# List families available in a region (cloud-provider id: 1=AWS, 2=GCP):
#   curl -s -H "Authorization: Bearer $SCYLLADB_CLOUD_TOKEN" \
#     "https://api.cloud.scylladb.com/deployment/cloud-provider/1/regions?defaults=true" \
#     | jq -r '.data.instances[].instanceFamily' | sort -u
export AWS_INSTANCE_FAMILY="i8g"
export GCP_INSTANCE_FAMILY="n2-highmem"
export STORAGE_MIN_GB="500"
export STORAGE_TARGET_UTIL="0.8"
export VCPU_MIN="6"

# --- AWS client networking -------------------------------------------------
# vpc_peering | transit_gateway | none
# "none" builds the cluster only and needs no AWS credentials at all.
export AWS_CONNECTION_TYPE="vpc_peering"

# true  -> peer to this account's default VPC
# false -> build a dedicated client VPC per cluster
export AWS_USE_DEFAULT_VPC="true"

# --- Cluster CIDRs ---------------------------------------------------------
# A route table holds only one route per destination prefix, so the two AWS
# clusters need DISTINCT CIDRs when both peer to the same client network.
# Check what is already routed there before choosing:
#   aws ec2 describe-route-tables --filters "Name=vpc-id,Values=<vpc>" \
#     --query 'RouteTables[*].Routes[*].[DestinationCidrBlock,State]' --output text
# Watch for "blackhole" routes from deleted peerings - they still occupy a prefix.
export AWS_SCYLLA_CIDR="172.28.0.0/24"
export AWS_BYOA_CIDR="172.27.0.0/24"
export GCP_SCYLLA_CIDR="172.28.0.0/24"
export GCP_BYOA_CIDR="172.27.0.0/24"
